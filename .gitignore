# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Secrets — NEVER commit these
.env
.env.*
!.env.example
*.key
secrets/

# Local tooling / editor
.claude/
.vscode/
.idea/

# Generated artifacts (regenerable; committed outputs live in output/ and benchmarks/)
artifacts/

# Per-run CLI output. `autocarto run --out <dir>` writes a trace + map per
# invocation; these are reproducible from the prompt and seed, so they are
# working files, not artifacts. The curated figures under output/figures/
# and the reference traces under output/traces/ ARE committed and stay so.
output/run/
output/run_*/

# Paper figures are byte-identical copies of output/figures/ (verified), so
# committing them would store the same images three times. paper/README.md
# has the one-line command that repopulates them before a LaTeX build.
paper/figures/*.png
paper/figures/*.pdf
paper/submission/latex/figures/

# LaTeX build leftovers; the compiled PDF under paper/submission/pdf/ is
# what gets committed.
paper/submission/latex/*.aux
paper/submission/latex/*.bbl
paper/submission/latex/*.blg
paper/submission/latex/*.fdb_latexmk
paper/submission/latex/*.fls
paper/submission/latex/*.log
paper/submission/latex/*.out
paper/submission/latex/main.pdf

# OS noise
Thumbs.db
.DS_Store
