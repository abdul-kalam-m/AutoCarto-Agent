FROM node:22-bookworm-slim AS frontend
WORKDIR /build/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM python:3.12-slim AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOST=0.0.0.0 PORT=8000 MPLCONFIGDIR=/tmp/matplotlib
WORKDIR /app
COPY pyproject.toml README.md constraints-ci.txt constraints-web-linux.txt ./
COPY src/ ./src/
COPY --from=frontend /build/src/autocarto/web/static ./src/autocarto/web/static/
RUN pip install --no-cache-dir -c constraints-ci.txt -c constraints-web-linux.txt '.[web]' && useradd --create-home --uid 10001 cartollm
USER cartollm
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.getenv('PORT', '8000') + '/api/health', timeout=4)"
CMD ["autocarto-web"]
