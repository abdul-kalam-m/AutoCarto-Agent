# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real keys. `src/autocarto/env.py` reads these (real
# environment variables take precedence over the file).

# Census Data API key — required only to regenerate snapshots via
# scripts/snapshot_acs.py (CLI) or scripts/snapshot_nj_web.py (NJ web catalog).
# Free: https://api.census.gov/data/key_signup.html
# (CDC PLACES and TIGER need no key.)
CENSUS_API_KEY=your-census-api-key-here

# NVIDIA API key — for the real open-source LLM tier (Tier 1 semantic
# engine) via NVIDIA's OpenAI-compatible endpoint at
# integrate.api.nvidia.com. Used by `autocarto run --llm nvidia`.
# Get one at https://build.nvidia.com/ . Not needed for `--llm mock`.
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# Optional web intent model override (the CLI model setting is separate).
AUTOCARTO_WEB_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Beta settings are read from process environment (Render/Compose), not dotenv.
# Set real values privately; do not commit database URLs or invitation codes.
AUTOCARTO_AUTH_REQUIRED=1
AUTOCARTO_AI_DAILY_LIMIT=20
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB
# AUTOCARTO_DEPLOYMENT=production
# AUTOCARTO_PUBLIC_URL=https://YOUR-SERVICE.onrender.com
# SENTRY_DSN=YOUR-PROJECT-DSN
# BETA_DB_PASSWORD=URL_SAFE_RANDOM_PASSWORD
