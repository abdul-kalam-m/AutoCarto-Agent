# AutoCarto-Agent curated style — bivariate maps
# Same minimalist frame as choropleth.mplstyle, but leaves slightly more
# legend real estate for the 3x3 bivariate legend swatch and the
# correlation-statistic annotation Gate 6 requires on every bivariate map.

figure.facecolor: white
figure.dpi: 150
savefig.dpi: 300
savefig.facecolor: white
savefig.bbox: tight

font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial, Helvetica
font.size: 9.0

axes.titlesize: 12.0
axes.titleweight: bold
axes.titlepad: 8.0
axes.edgecolor: none
axes.linewidth: 0.0
axes.grid: False
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.spines.bottom: False
axes.labelsize: 6.5

xtick.bottom: False
xtick.labelbottom: False
xtick.labelsize: 5.5
ytick.left: False
ytick.labelleft: False
ytick.labelsize: 5.5

legend.frameon: True
legend.framealpha: 0.92
legend.edgecolor: 0.8
legend.fontsize: 7.0

text.color: 0.15
axes.labelcolor: 0.15

patch.edgecolor: white
patch.linewidth: 0.15
